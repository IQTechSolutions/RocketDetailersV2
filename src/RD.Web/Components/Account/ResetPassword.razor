@page "/Account/ResetPassword"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using RD.Web.Services
@inject PasswordResetService Reset

<PageTitle>Choose a new password — Rocket Detailer Control Plane</PageTitle>

<div class="rd-auth-shell">
    <div class="rd-auth-card">
        <div class="rd-auth-brand">🚀 Rocket Detailer</div>
        <div class="rd-auth-sub">Choose a new password</div>

        @if (_done)
        {
            <p class="rd-auth-note">
                Your password has been changed, and any other sessions signed in as you have been signed out.
            </p>
            <a href="/Account/Login" class="rd-auth-btn" style="display:block;text-align:center;text-decoration:none;">Sign in</a>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="reset-password">
                <DataAnnotationsValidator />
                @if (_error is not null)
                {
                    <div class="rd-auth-error">@_error</div>
                }
                @* Carried in the form, not re-read from the query, so the token survives
                   a validation round-trip intact. *@
                <input type="hidden" name="Input.Code" value="@Input.Code" />

                <label class="rd-auth-label" for="email">Email</label>
                <InputText id="email" @bind-Value="Input.Email" class="rd-auth-field" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" />

                <label class="rd-auth-label" for="password">New password</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" class="rd-auth-field" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Password" />

                <label class="rd-auth-label" for="confirm">Confirm new password</label>
                <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" class="rd-auth-field" autocomplete="new-password" />
                <ValidationMessage For="() => Input.ConfirmPassword" />

                <button type="submit" class="rd-auth-btn">Set password</button>
            </EditForm>
            <div class="rd-auth-links">
                <a href="/Account/ForgotPassword" class="rd-auth-link">Request a new link</a>
                <a href="/Account/Login" class="rd-auth-link">Back to sign in</a>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? Code { get; set; }

    private string? _error;
    private bool _done;

    // On the GET the token arrives in the query; on the POST it comes back in the
    // hidden field, so only seed it when the form hasn't supplied one.
    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Input.Code)) Input.Code = Code;
    }

    private async Task Submit()
    {
        var result = await Reset.ResetAsync(Input.Email, Input.Code, Input.Password);
        if (result.Ok) _done = true;
        else _error = result.Error;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "An email is required.")]
        [EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "A new password is required.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The two passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";

        /// <summary>The base64url reset token from the emailed link.</summary>
        public string? Code { get; set; }
    }
}
