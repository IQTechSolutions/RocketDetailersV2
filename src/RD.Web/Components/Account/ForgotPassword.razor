@page "/Account/ForgotPassword"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using RD.Web.Services
@inject PasswordResetService Reset
@inject NavigationManager Nav

<PageTitle>Reset your password — Rocket Detailer Control Plane</PageTitle>

<div class="rd-auth-shell">
    <div class="rd-auth-card">
        <div class="rd-auth-brand">🚀 Rocket Detailer</div>
        <div class="rd-auth-sub">Reset your password</div>

        @if (!Reset.EmailConfigured)
        {
            @* A deployment-level fact, not a fact about any account — safe to state plainly. *@
            <p class="rd-auth-note">
                Password reset by email isn't configured on this deployment.
                Ask an Admin to set a new password for you from Settings → Users.
            </p>
        }
        else if (_sent)
        {
            <p class="rd-auth-note">
                If that address belongs to an account, a reset link is on its way.
                The link works once and expires in two hours.
            </p>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="SendLink" FormName="forgot-password">
                <DataAnnotationsValidator />
                <p class="rd-auth-note">
                    Enter your email and we'll send you a link to choose a new password.
                </p>
                <label class="rd-auth-label" for="email">Email</label>
                <InputText id="email" @bind-Value="Input.Email" class="rd-auth-field" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" />
                <button type="submit" class="rd-auth-btn">Send reset link</button>
            </EditForm>
        }

        <a href="/Account/Login" class="rd-auth-cancel">Back to sign in</a>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    private bool _sent;

    // Always the same confirmation, whether or not the address matched an account:
    // the response must not tell an anonymous caller who has a login here.
    private async Task SendLink()
    {
        await Reset.RequestAsync(Input.Email, Nav.BaseUri, HttpContext.RequestAborted);
        _sent = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "An email is required.")]
        [EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        public string Email { get; set; } = "";
    }
}
