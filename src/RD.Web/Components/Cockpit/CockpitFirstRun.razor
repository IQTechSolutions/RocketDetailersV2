@* F6 first-run state: import progress + guided next step. Shown until the first sync completes. *@
<MudPaper Class="pa-6" Elevation="1">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5">First run — let's get the engine ready</MudText>
            <HelpHint Text="This panel shows until the first Stripe/Meta sync completes. Until then the engine has no money data and every client stays safely in Shadow mode." />
        </MudStack>

        <MudText Typo="Typo.body1" Class="mud-text-secondary">
            @_importSummary @_nextStep
        </MudText>

        <div>
            <MudText Typo="Typo.subtitle2">
                @Snapshot.ClientsLinked of @Snapshot.TotalClients clients linked
            </MudText>
            <MudProgressLinear Value="@_percent" Color="Color.Primary" Rounded="true" Size="Size.Large" Class="my-2"
                               aria-label="@($"{Snapshot.ClientsLinked} of {Snapshot.TotalClients} clients linked")" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                A client counts as linked once it has an active Stripe subscription link — the thread that ties payments to ads.
            </MudText>
        </div>

        <div>
            @if (_isEmpty)
            {
                @* There is no in-app import surface — the roster load is a one-time
                   CLI seed run (src/RD.Tools.Import, disposable by design), so the
                   empty state hands over the command instead of linking nowhere. *@
                <MudText Typo="Typo.subtitle2">Start here — import the client roster</MudText>
                <code style="font-size:.78rem;display:inline-block;" class="my-2">@SeedImportCommand</code>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                    A one-time seed load of the reconciliation spreadsheet, run from a repo checkout with the .NET SDK —
                    the importer is not part of this deployment. Point <code>--conn</code> at this environment's database:
                    omit it and the tool reports success after loading into a local LocalDB instead. Reload this page once it finishes.
                </MudText>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Build" Href="/reconciliation">
                    Start here — fix mappings
                </MudButton>
            }
        </div>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public CockpitSnapshot Snapshot { get; set; } = default!;

    /// <summary>
    /// The documented seed-import usage (see RD.Tools.Import/Program.cs). <c>--conn</c> is shown
    /// deliberately: the importer silently falls back to a local LocalDB instance without it.
    /// </summary>
    private const string SeedImportCommand =
        "dotnet run --project src/RD.Tools.Import -- \"<xlsx path>\" --conn \"<connection string>\"";

    // A brand-new deployment has no clients at all — nothing to reconcile and no
    // roster to describe — so both the framing and the next step have to change.
    private bool _isEmpty => Snapshot.TotalClients == 0;

    private string _importSummary => Snapshot.TotalClients switch
    {
        0 => "No clients have been imported yet, and no sync has completed, so money numbers aren't live.",
        1 => "Your 1 imported client is here, but no sync has completed yet, so money numbers aren't live.",
        var n => $"Your {n} imported clients are here, but no sync has completed yet, so money numbers aren't live.",
    };

    private string _nextStep => _isEmpty
        ? "The first move: load the client roster — mappings, billing, and enforcement all hang off it."
        : "The best first move: fix identity mappings — billing can only protect clients whose Stripe subscription is linked.";

    private double _percent => Snapshot.TotalClients == 0
        ? 0
        : 100.0 * Snapshot.ClientsLinked / Snapshot.TotalClients;
}
