@* Right rail, always visible: open investigation items grouped by kind, in plain English, each linking into the work queue. *@
<MudPaper Elevation="1" Class="pa-4" Style="height:100%;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudText Typo="Typo.h6">Open investigations</MudText>
        <HelpHint Text="Safety, billing, sync, and identity work awaiting review. Counts are open work items, not live vendor totals — open an item and verify its current evidence before resolving it." />
    </MudStack>

    @if (Gaps.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Celebration"
                    Title="No open investigations"
                    Hint="Nothing currently needs operator review in this queue." />
    }
    else
    {
        @foreach (var gap in Gaps)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2">
                <MudText Typo="Typo.subtitle2">
                    @gap.Count open @(gap.Count == 1 ? "item" : "items") — @gap.Kind.Title()
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@gap.Kind.WhyItMatters()</MudText>
                <MudLink Href="@($"/reconciliation?kind={gap.Kind}")" Typo="Typo.caption" Class="mt-1 d-inline-block">
                    → Review items
                </MudLink>
            </MudPaper>
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MappingGap> Gaps { get; set; } = [];
}
