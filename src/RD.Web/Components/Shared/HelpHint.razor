@* Req 16: every KPI and panel carries a plain-English help hint. *@
<MudTooltip Text="@Text" Arrow="true" Placement="Placement.Top" Class="rd-help-tooltip">
    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline"
             Style="font-size:1rem;opacity:.55;cursor:help;vertical-align:middle;"
             aria-label="Help" />
</MudTooltip>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
}
