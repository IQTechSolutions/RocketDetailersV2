@* Admin sets a new password for a user (no current-password check). *@
@using RD.Web.Services
@inject IdentityAdminService Admin
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Set password — @UserEmail</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_password" Label="New password" Variant="Variant.Outlined"
                      InputType="InputType.Password" Immediate="true"
                      HelperText="Share it securely; the user can change it after signing in." />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog!.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_password))">
            @(_busy ? "Setting…" : "Set password")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? Dialog { get; set; }

    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public string? UserEmail { get; set; }

    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true; _error = null;
        var result = await Admin.SetPasswordAsync(UserId, _password);
        _busy = false;
        if (result.Ok) { Snackbar.Add(result.Message, Severity.Success); Dialog!.Close(DialogResult.Ok(true)); }
        else _error = result.Message;
    }
}
