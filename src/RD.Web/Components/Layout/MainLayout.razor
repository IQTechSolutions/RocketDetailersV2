@inherits LayoutComponentBase

<MudThemeProvider @ref="_themeProvider" Theme="RdTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6" Class="ml-2" Style="letter-spacing:.02em;white-space:nowrap;">
            🚀 Rocket Detailer <span style="font-weight:400;opacity:.72;">— Control Plane</span>
        </MudText>
        <MudSpacer />
        <MudTooltip Arrow="true" Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Color="Color.Inherit"
                           Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="@(() => _isDarkMode = !_isDarkMode)"
                           aria-label="Toggle dark mode" />
        </MudTooltip>
        <AuthorizeView>
            <MudTooltip Arrow="true" Text="@context.User.Identity?.Name">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="ml-2" />
            </MudTooltip>
            <MudButton Href="/Account/Logout" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout" Class="ml-1">Sign out</MudButton>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0"
               Variant="@DrawerVariant.Responsive">
        <MudNavMenu Class="pt-2">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Cockpit</MudNavLink>
            <MudNavLink Href="/clients" Icon="@Icons.Material.Filled.Storefront">Clients</MudNavLink>
            <MudNavLink Href="/reconciliation" Icon="@Icons.Material.Filled.Rule">Reconciliation</MudNavLink>
            <MudNavLink Href="/mapping" Icon="@Icons.Material.Filled.Hub">Mapping</MudNavLink>
            <MudNavLink Href="/ladder" Icon="@Icons.Material.Filled.Stairs">Ladder</MudNavLink>
            <MudNavLink Href="/analytics" Icon="@Icons.Material.Filled.Insights">Analytics</MudNavLink>
            <MudNavLink Href="/ops" Icon="@Icons.Material.Filled.Healing">Operations</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-4 pa-md-6">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private MudThemeProvider? _themeProvider;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
