@page "/analytics"
@attribute [Authorize]
@inject AnalyticsService AnalyticsSvc

<PageTitle>Analytics — Rocket Detailer Control Plane</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudText Typo="Typo.h5">Owner analytics</MudText>
    <HelpHint Text="The money view: net cash position per master-account client, company exposure, package revenue and enforcement activity — all read-only queries over the ledger and decision log. Nothing here writes to the database." />
</MudStack>

@if (_snapshot is null)
{
    @* Loading: headline card skeletons + panel skeletons — never a blank page. *@
    <MudGrid Spacing="3">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="150px" /></MudItem>
        }
        <MudItem xs="12" md="7"><MudPaper Elevation="1"><GridSkeleton Rows="6" /></MudPaper></MudItem>
        <MudItem xs="12" md="5"><MudPaper Elevation="1"><GridSkeleton Rows="6" /></MudPaper></MudItem>
    </MudGrid>
}
else
{
    <AnalyticsBody Snapshot="_snapshot" />
}

@code {
    private AnalyticsSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
        => _snapshot = await AnalyticsSvc.GetSnapshotAsync();
}
