@page "/settings"
@attribute [Authorize]

<PageTitle>Settings — Rocket Detailer Control Plane</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudText Typo="Typo.h5">Settings</MudText>
    <HelpHint Text="Operational controls land here as the milestones that need them ship." />
</MudStack>

<MudStack Spacing="3">
    <KillSwitchCard />

    <MudPaper Elevation="1">
        <EmptyState Icon="@Icons.Material.Outlined.Settings"
                    Title="More controls on the way"
                    Hint="Package configuration and the audited package-edit page, the working-hours calendar and freshness bounds, and message-template editing land here as their milestones ship.">
            <MudButton Variant="Variant.Outlined" Href="/" StartIcon="@Icons.Material.Filled.SpaceDashboard">
                Back to the cockpit
            </MudButton>
        </EmptyState>
    </MudPaper>
</MudStack>
