@page "/clients/{Id:guid}"
@attribute [Authorize]
@using RD.Domain
@using RD.Domain.Entities
@using RD.Web.Components.Dialogs
@inject ClientDirectoryService Directory
@inject TrialAdminService Trials
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Client — Rocket Detailer Control Plane</PageTitle>

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-4" />
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6"><MudPaper Elevation="1"><GridSkeleton Rows="5" /></MudPaper></MudItem>
        <MudItem xs="12" md="6"><MudPaper Elevation="1"><GridSkeleton Rows="5" /></MudPaper></MudItem>
    </MudGrid>
}
else if (_detail is null)
{
    <EmptyState Icon="@Icons.Material.Outlined.PersonOff" Title="Client not found"
                Hint="This client doesn't exist (or the link is stale).">
        <MudButton Variant="Variant.Outlined" Href="/clients" StartIcon="@Icons.Material.Filled.ArrowBack">Back to clients</MudButton>
    </EmptyState>
}
else
{
    var c = _detail.Client;

    @if (c.MergedIntoClientId is Guid mergedInto)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <span>
                    This account was merged into another and is <b>retired</b> — its vendor records are now monitored under the surviving account.
                    <MudLink Href="@($"/clients/{mergedInto}")" Class="ml-1">Open the surviving account →</MudLink>
                </span>
                @* Reverse the merge: restore this account and move its links/history back. Operator-only. *@
                <AuthorizeView Roles="@Roles.OperatorRolesCsv" Context="auth">
                    <MudTooltip Arrow="true" Text="Merged by mistake? Unmerge to restore this account and move its links and history back off the survivor.">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.CallSplit" OnClick="OpenUnmergeAsync">Unmerge…</MudButton>
                    </MudTooltip>
                </AuthorizeView>
            </MudStack>
        </MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/clients" aria-label="Back to clients" />
            <MudText Typo="Typo.h5">@c.BusinessName</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(c.ContractType == ContractType.Trial ? Color.Warning : Color.Success)">@c.ContractType</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(c.AccountType == AccountType.Master ? Color.Primary : Color.Default)">@c.AccountType account</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(c.Country ?? "—") · @c.CurrencyCode</MudChip>
            <ModeBadge Mode="@c.EnforcementMode" />
            <MudSpacer />
            @* Merge a duplicate business record into this one (or this one into it). Operator-only. *@
            <AuthorizeView Roles="@Roles.OperatorRolesCsv" Context="auth">
                <MudTooltip Arrow="true" Text="Two records for the same business? Merge them — links and history move to the survivor; the duplicate is retired but still monitored.">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Merge" OnClick="OpenMergeAsync">Merge…</MudButton>
                </MudTooltip>
            </AuthorizeView>
            @* Mode changes are gated on verified mappings — the control exists but stays honest about why it's locked. *@
            <MudTooltip Arrow="true" Text="Mode changes unlock after mapping verification (M2). Until then every client stays where the ladder put them.">
                <span>
                    <MudSelect T="EnforcementMode" Value="@c.EnforcementMode" Disabled="true" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Label="Enforcement mode" Style="min-width:11rem;">
                        <MudSelectItem T="EnforcementMode" Value="EnforcementMode.Shadow">Shadow — observe only</MudSelectItem>
                        <MudSelectItem T="EnforcementMode" Value="EnforcementMode.Assist">Assist — human approves</MudSelectItem>
                        <MudSelectItem T="EnforcementMode" Value="EnforcementMode.Auto">Auto — engine acts</MudSelectItem>
                    </MudSelect>
                </span>
            </MudTooltip>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            @(c.ContactName ?? "No contact name")
            @if (!string.IsNullOrEmpty(c.Email)) { <span> · @c.Email</span> }
            @if (!string.IsNullOrEmpty(c.Phone)) { <span> · @c.Phone</span> }
        </MudText>
    </MudPaper>

    @* ---- Account health: what's currently wrong with this account. ---- *@
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudIcon Icon="@(_detail.Health.IsHealthy ? Icons.Material.Filled.HealthAndSafety : Icons.Material.Filled.ReportProblem)"
                     Color="@(_detail.Health.IsHealthy ? Color.Success : Color.Warning)" />
            <MudText Typo="Typo.h6">Account health</MudText>
            <HelpHint Text="Everything currently blocking this client from clean, enforceable operation: missing or unverified required links and open reconciliation items. Clear these to let the client climb the enforcement ladder." />
            <MudSpacer />
            @if (!_detail.Health.IsHealthy)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error">
                    @_detail.Health.Issues.Count @(_detail.Health.Issues.Count == 1 ? "issue" : "issues")
                </MudChip>
            }
        </MudStack>

        @if (_detail.Health.IsHealthy)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Icon="@Icons.Material.Filled.CheckCircle">
                No open issues — this account's required links are in place and verified, with nothing in the reconciliation queue.
            </MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var issue in _detail.Health.Issues)
                {
                    <MudAlert Severity="@IssueSeverity(issue.Severity)" Variant="Variant.Outlined" Dense="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <div style="flex:1;min-width:16rem;">
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@issue.Title</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" Style="white-space:normal;">@issue.Detail</MudText>
                            </div>
                            @if (!string.IsNullOrEmpty(issue.FixHref))
                            {
                                <MudButton Href="@issue.FixHref" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward">
                                    @issue.FixLabel
                                </MudButton>
                            }
                        </MudStack>
                    </MudAlert>
                }
            </MudStack>
        }
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-4" Style="height:100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudText Typo="Typo.h6">Identity links</MudText>
                    <HelpHint Text="How this client is known in each external system. A link must be active (not invalidated) for the engine to use it; verification pins it for enforcement." />
                    <MudSpacer />
                    <AddGhlContactButton ClientId="@c.Id" Email="@c.Email" Name="@c.BusinessName"
                                         Show="@(!_detail.Links.Any(l => l.System == ExternalSystem.Ghl && l.Kind == LinkKind.Contact))"
                                         OnCreated="ReloadAsync" />
                </MudStack>
                @if (_detail.Links.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.LinkOff" Title="No identity links"
                                Hint="This client is invisible to the engine until at least a Stripe subscription is linked." />
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead>
                            <tr><th>System</th><th>Kind</th><th>External id</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _detail.Links)
                            {
                                <tr>
                                    <td>@l.System.Label()</td>
                                    <td>@l.Kind.Label()</td>
                                    <td>
                                        <code style="font-size:.75rem;">@l.ExternalId</code>
                                        @if (_detail.ExternalLinks.TryGetValue(l.Id, out var url))
                                        {
                                            <MudTooltip Arrow="true" Text="@VendorLinks.Label(l.System)">
                                                <MudIconButton Href="@url" Target="_blank" rel="noopener noreferrer"
                                                               Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="ml-1"
                                                               aria-label="@VendorLinks.Label(l.System)" />
                                            </MudTooltip>
                                        }
                                    </td>
                                    <td>
                                        @if (l.InvalidatedAt is not null)
                                        {
                                            <MudTooltip Arrow="true" Text="@($"Invalidated {l.InvalidatedAt:yyyy-MM-dd}. The engine ignores this link.")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">Invalidated</MudChip>
                                            </MudTooltip>
                                        }
                                        else if (l.VerifiedAt is not null)
                                        {
                                            <MudTooltip Arrow="true" Text="@($"Verified {l.VerifiedAt:yyyy-MM-dd} — pinned for enforcement.")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">Verified</MudChip>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudTooltip Arrow="true" Text="Imported but not yet human-verified. Verification is what unlocks Assist mode.">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Unverified</MudChip>
                                            </MudTooltip>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="pa-4" Style="height:100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudText Typo="Typo.h6">Ledger</MudText>
                    <HelpHint Text="Append-only money trail: charges in, ad spend out. Corrections are new compensating entries — history never changes." />
                </MudStack>
                @if (_detail.Ledger.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong"
                                Title="No money movements recorded yet"
                                Hint="The ledger starts with the first sync." />
                }
                else
                {
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                        @foreach (var entry in _detail.Ledger)
                        {
                            <MudTimelineItem Color="@LedgerColor(entry.Type)" Size="Size.Small" Variant="Variant.Filled">
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">
                                        @entry.Type.Label() · @Human.MoneySigned(entry.SignedAmount, entry.CurrencyCode)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @entry.OccurredAt.ToString("yyyy-MM-dd HH:mm") UTC · @entry.SourceSystem.Label()
                                    </MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                }
            </MudPaper>
        </MudItem>

        @if (_detail.Trials.Count > 0)
        {
            <MudItem xs="12" md="6">
                <MudPaper Elevation="1" Class="pa-4" Style="height:100%;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudText Typo="Typo.h6">Trial periods</MudText>
                        <HelpHint Text="Trials suppress payment enforcement while active — but a trial with no expiry date is an investigation item, not a free pass." />
                    </MudStack>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead><tr><th>Starts</th><th>Expires</th><th>Spend cap</th><th>Outcome</th></tr></thead>
                        <tbody>
                            @foreach (var t in _detail.Trials)
                            {
                                <tr>
                                    <td>@t.StartsAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (t.ExpiresAt is null)
                                        {
                                            <MudTooltip Arrow="true" Text="Unknown expiry — flagged for investigation. Enforcement needs the real date.">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">unknown</MudChip>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            @t.ExpiresAt.Value.ToString("yyyy-MM-dd")
                                        }
                                        <AuthorizeView Roles="@Roles.OperatorRolesCsv" Context="auth">
                                            <MudTooltip Arrow="true" Text="@(t.ExpiresAt is null ? "Set the trial expiry date" : "Change the trial expiry date")">
                                                <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small"
                                                               Color="@(t.ExpiresAt is null ? Color.Warning : Color.Default)"
                                                               OnClick="@(() => HandleSetExpiryAsync(t))"
                                                               aria-label="Set trial expiry" />
                                            </MudTooltip>
                                        </AuthorizeView>
                                    </td>
                                    <td>@(t.SpendCapSnapshot is null ? "—" : Human.MoneyKpi(t.SpendCapSnapshot.Value, c.CurrencyCode))</td>
                                    <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@t.Outcome</MudChip></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" md="@(_detail.Trials.Count > 0 ? 6 : 12)">
            <MudPaper Elevation="1" Class="pa-4" Style="height:100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudText Typo="Typo.h6">Engine decisions</MudText>
                    <HelpHint Text="Every policy evaluation for this client lands here with its evidence — the answer to 'why did the engine do that?'" />
                </MudStack>
                <EmptyState Icon="@Icons.Material.Outlined.Psychology"
                            Title="Engine decisions will appear here — the 'Why?' trail"
                            Hint="Once the eligibility policy runs (shadow first), every would-pause / would-resume / needs-investigation decision shows up with its evidence." />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ClientDetail? _detail;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _detail = await Directory.GetDetailAsync(Id);
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _detail = await Directory.GetDetailAsync(Id);
        StateHasChanged();
    }

    private async Task OpenMergeAsync()
    {
        if (_detail is null) return;
        var parameters = new DialogParameters<MergeClientDialog>
        {
            { d => d.CurrentClientId, _detail.Client.Id },
            { d => d.CurrentClientName, _detail.Client.BusinessName },
        };
        var dialog = await Dialogs.ShowAsync<MergeClientDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not Guid survivorId) return;

        // If THIS client was the one retired, its page is now a shell — go to the survivor.
        if (survivorId != _detail.Client.Id)
            Nav.NavigateTo($"/clients/{survivorId}");
        else
            await ReloadAsync();
    }

    private async Task OpenUnmergeAsync()
    {
        if (_detail is null) return;
        var parameters = new DialogParameters<UnmergeClientDialog>
        {
            { d => d.DuplicateClientId, _detail.Client.Id },
            { d => d.DuplicateClientName, _detail.Client.BusinessName },
        };
        var dialog = await Dialogs.ShowAsync<UnmergeClientDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        // This page is now a live account again — reload it in place.
        await ReloadAsync();
    }

    private async Task HandleSetExpiryAsync(TrialPeriod trial)
    {
        var parameters = new DialogParameters<SetTrialExpiryDialog>
        {
            { d => d.MinDate, trial.StartsAt.UtcDateTime.Date },
            { d => d.Initial, trial.ExpiresAt?.UtcDateTime.Date },
        };
        var dialog = await Dialogs.ShowAsync<SetTrialExpiryDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not DateTime picked) return;

        var expiresAt = new DateTimeOffset(DateTime.SpecifyKind(picked.Date, DateTimeKind.Utc));
        var write = await Trials.SetExpiryAsync(trial.Id, expiresAt);
        Snackbar.Add(write.Message, write.Ok ? Severity.Success : Severity.Warning);
        if (write.Ok) await ReloadAsync();
    }

    private static Color LedgerColor(LedgerEntryType type) => type switch
    {
        LedgerEntryType.ChargePaid => Color.Success,
        LedgerEntryType.ChargeFailed => Color.Error,
        LedgerEntryType.AdSpend => Color.Info,
        LedgerEntryType.Refund or LedgerEntryType.Dispute => Color.Warning,
        _ => Color.Default,
    };

    private static Severity IssueSeverity(AccountIssueSeverity severity) => severity switch
    {
        AccountIssueSeverity.Error => Severity.Error,
        AccountIssueSeverity.Warning => Severity.Warning,
        _ => Severity.Info,
    };
}
